[Unit]
Description=containerd (Rootless)
Requires=dbus.socket

[Service]
Environment=PATH=/home/bryant-biggs/.local/nerdctl-full/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=CONTAINERD_ROOTLESS_ROOTLESSKIT_FLAGS=
ExecStart=/home/bryant-biggs/.local/nerdctl-full/bin/containerd-rootless.sh
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
Type=simple
KillMode=mixed

[Install]
WantedBy=default.target
